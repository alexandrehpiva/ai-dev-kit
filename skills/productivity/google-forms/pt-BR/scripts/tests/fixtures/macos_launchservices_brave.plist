<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fixture sintética no formato do com.apple.launchservices.secure.plist (macOS).
     O bundle id vem em minúsculas, como o LaunchServices grava (R6 §1.2). -->
<plist version="1.0">
<dict>
  <key>LSHandlers</key>
  <array>
    <dict>
      <key>LSHandlerContentType</key><string>public.html</string>
      <key>LSHandlerRoleAll</key><string>com.brave.browser</string>
    </dict>
    <dict>
      <key>LSHandlerPreferredVersions</key><dict><key>LSHandlerRoleAll</key><string>-</string></dict>
      <key>LSHandlerRoleAll</key><string>-</string>
      <key>LSHandlerURLScheme</key><string>https</string>
    </dict>
    <dict>
      <key>LSHandlerRoleAll</key><string>com.brave.browser</string>
      <key>LSHandlerURLScheme</key><string>https</string>
    </dict>
    <dict>
      <key>LSHandlerRoleAll</key><string>com.brave.browser</string>
      <key>LSHandlerURLScheme</key><string>http</string>
    </dict>
  </array>
</dict>
</plist>
