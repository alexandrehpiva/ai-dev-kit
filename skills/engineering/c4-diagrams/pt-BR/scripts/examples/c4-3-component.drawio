rona (seta tracejada)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="90" y="1086" width="292" height="24" as="geometry"/></mxCell><mxCell id="lgn" value="Setas unidirecionais: o rótulo descreve a intenção; [colchetes] = tecnologia." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5F6B76;" vertex="1" parent="1"><mxGeometry x="42" y="1112" width="340" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>