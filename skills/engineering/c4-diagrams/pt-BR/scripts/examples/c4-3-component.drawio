<mxfile host="app.diagrams.net"><diagram name="Component diagram for API de Pedidos" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1910" pageHeight="1172" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="&lt;b style=&quot;font-size:18px&quot;&gt;Component diagram for API de Pedidos&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1440" height="36" as="geometry"/></mxCell><mxCell id="el101" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Aplicação Web&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: TypeScript, SPA no navegador]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Catálogo, carrinho e acompanhamento&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="240" height="130" as="geometry"/></mxCell><mxCell id="bd102" value="&lt;b style=&quot;font-size:13px&quot;&gt;API de Pedidos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container]&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5F6B76;strokeWidth=2;dashed=1;dashPattern=10 6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#5F6B76;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="800" height="780" as="geometry"/></mxCell><mxCell id="el103" value="&lt;span style=&quot;color:#1B2733&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Controlador de Pedidos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: Node.js, REST controller]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Recebe e valida requisições HTTP de pedidos&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#CFE3F7;strokeColor=#2F6FB5;strokeWidth=2;fontColor=#1B2733;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="240" height="120" as="geometry"/></mxCell><mxCell id="el104" value="&lt;span style=&quot;color:#1B2733&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Serviço de Pedidos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: TypeScript, classe de serviço]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Regras de negócio: criar, pagar e cancelar pedido&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#CFE3F7;strokeColor=#2F6FB5;strokeWidth=2;fontColor=#1B2733;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="430" width="240" height="120" as="geometry"/></mxCell><mxCell id="el105" value="&lt;span style=&quot;color:#1B2733&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Repositório de Pedidos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: TypeScript, acesso a dados]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Persiste e consulta pedidos&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#CFE3F7;strokeColor=#2F6FB5;strokeWidth=2;fontColor=#1B2733;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="700" width="240" height="120" as="geometry"/></mxCell><mxCell id="el106" value="&lt;span style=&quot;color:#1B2733&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Publicador de Eventos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: TypeScript, produtor AMQP]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Publica eventos de domínio na fila&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#CFE3F7;strokeColor=#2F6FB5;strokeWidth=2;fontColor=#1B2733;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="160" width="240" height="120" as="geometry"/></mxCell><mxCell id="el107" value="&lt;span style=&quot;color:#1B2733&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Cliente de Cobrança&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Component: TypeScript, cliente HTTP]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Encapsula a chamada ao gateway de pagamento&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#CFE3F7;strokeColor=#2F6FB5;strokeWidth=2;fontColor=#1B2733;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="430" width="240" height="120" as="geometry"/></mxCell><mxCell id="el108" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Fila de Eventos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Mensageria AMQP]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Eventos de pedido&lt;/div&gt;&lt;/span&gt;" style="shape=process;backgroundOutline=1;size=0.08;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="155" width="250" height="130" as="geometry"/></mxCell><mxCell id="el109" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Gateway de Pagamento&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External Software System]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Processa cobranças de cartão e Pix&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#5F6B76;strokeColor=#3F4A54;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#FFFFFF;align=center;verticalAlign=