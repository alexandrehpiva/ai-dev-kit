<mxfile host="app.diagrams.net"><diagram name="Dynamic diagram for Fazer pedido (Plataforma de Pedidos)" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1126" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="&lt;b style=&quot;font-size:18px&quot;&gt;Dynamic diagram for Fazer pedido (Plataforma de Pedidos)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1440" height="36" as="geometry"/></mxCell><mxCell id="el101" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Cliente&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Finaliza uma compra&lt;/div&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontSize=12;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="200" height="150" as="geometry"/></mxCell><mxCell id="el102" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Aplicação Web&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: TypeScript, SPA no navegador]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Coleta os dados do pedido&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="el103" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;API de Pedidos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Node.js, REST/JSON]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Valida e registra o pedido&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="el104" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Gateway de Pagamento&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External Software System]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Processa a cobrança&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#5F6B76;strokeColor=#3F4A54;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="150" width="240" height="130" as="geometry"/></mxCell><mxCell id="el105" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Banco de Pedidos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: PostgreSQL]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Armazena o pedido&lt;/div&gt;&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="450" width="240" height="130" as="geometry"/></mxCell><mxCell id="el106" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Fila de Eventos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Mensageria AMQP]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Eventos de pedido&lt;/div&gt;&lt;/span&gt;" style="shape=process;backgroundOutline=1;size=0.08;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="450" width="240" height="130" as="geometry"/></mxCell><mxCell id="el107" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Worker de Notificações&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Node.js]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Dispara e-mails&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="720" width="240" height="130" as="geometry"/></mxCell><mxCell id="el108" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Serviço de E-mail&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External Software System]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Entrega e-mails&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#5F6B76;strokeColor=#3F4A54;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="240" height="130" as="geometry"/></mxCell><mxCell id="rl109" value="&lt;div style=&quot;font-size:11px&quot;&gt;&lt;b&gt;1. Confirma o pedido em&lt;/b&gt;&lt;br&gt;[HTTPS]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#44505C;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="el101" target="el102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rl110" value="&lt;div style=&quot;font-size:11px&quot;&gt;&lt;b&gt;2. Envia dados do pedido para&lt;/b&gt;&lt;br&gt;[JSON/HTTPS]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#44505C;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="el102" target="el103"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rl111" value="&lt;div style=&quot;font-size:11px&quot;&gt;&lt;b&gt;3. Grava o pedido em&lt;/b&gt;&lt;br&gt;[SQL/TCP]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#44505C;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="el103" target="el105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rl112" value="&lt;div style=&quot;font-size:11px&quot;&gt;&lt;b&gt;4. Solicita cobrança a&lt;/b&gt;&lt;br&gt;[REST/HTTPS]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#44505C;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="el103" target="el104"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rl113" value="&lt;div style=&quot;font-size:11px&quot;&gt;&lt;b&gt;5. Publica &amp;#x27;pedido criado&amp;#x27; em&lt;/b&gt;&lt;br&gt;[AMQP]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#44505C;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="el103" target="el106"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1104" y="365"/><mxPoint x="1500" y="365"/></Array></mxGeometry></mxCell><mxCell id="rl114" value="&lt;div style=&quot;font-size:11px&quot;&gt;&lt;b&gt;6. Entrega evento a&lt;/b&gt;&lt;br&gt;[AMQP]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#44505C;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="el106" target="el107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rl115" value="&lt;div style=&quot;font-size:11px&quot;&gt;&lt;b&gt;7. Envia confirmação por&lt;/b&gt;&lt;br&gt;[SMTP]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#44505C;fontColor=#1B2733;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="el107" target="el108"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lgbox" value="&lt;b&gt;Legenda&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6B76;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="360" height="196" as="geometry"/></mxCell><mxCell id="lgs0" value="" style="rounded=1;html=1;fillColor=#08427B;strokeColor=#08427B;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="42" y="940" width="40" height="18" as="geometry"/></mxCell><mxCell id="lgt0" value="Person" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="90" y="936" width="292" height="24" as="geometry"/></mxCell><mxCell id="lgs1"