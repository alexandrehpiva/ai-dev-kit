<mxfile host="app.diagrams.net"><diagram name="Container diagram for Plataforma de Pedidos" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1122" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ttl" value="&lt;b style=&quot;font-size:18px&quot;&gt;Container diagram for Plataforma de Pedidos&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#1B2733;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="1440" height="36" as="geometry"/></mxCell><mxCell id="el101" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Cliente&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Compra produtos e acompanha entregas&lt;/div&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontSize=12;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="200" height="150" as="geometry"/></mxCell><mxCell id="el102" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Atendente&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Consulta e corrige pedidos&lt;/div&gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;shape=mxgraph.c4.person2;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontSize=12;resizable=0;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="200" height="150" as="geometry"/></mxCell><mxCell id="bd103" value="&lt;b style=&quot;font-size:13px&quot;&gt;Plataforma de Pedidos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[System]&lt;/div&gt;" style="rounded=1;arcSize=3;whit