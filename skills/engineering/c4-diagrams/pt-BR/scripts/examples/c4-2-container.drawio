rokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="480" width="240" height="130" as="geometry"/></mxCell><mxCell id="el107" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Fila de Eventos&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Mensageria AMQP]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Eventos de pedido criado e pago&lt;/div&gt;&lt;/span&gt;" style="shape=process;backgroundOutline=1;size=0.08;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="380" width="250" height="130" as="geometry"/></mxCell><mxCell id="el108" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Worker de Notificações&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Container: Node.js]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Consome eventos e dispara e-mails&lt;/div&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#2F6FB5;strokeColor=#1F4F85;strokeWidth=2;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="640" width="250" height="130" as="geometry"/></mxCell><mxCell id="el109" value="&lt;span style=&quot;color:#FFFFFF&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;Gateway de Pagamento&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External Software System]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Processa cobranças de cartão e Pix&lt;/div&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#5F6B76;strokeColor=#3F4A54;strokeWidth=2;dashed=1;dashPattern=8 4;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1680" y="150